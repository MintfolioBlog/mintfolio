---
import SeoHead from '@mintfolio/theme-api/SeoHead.astro';
import type { SeoData, FaviconLink } from '@mintfolio/theme-api/astro';
interface Props { /** SEO policy already computed by Core. */ seo: SeoData; /** Used only without a site favicon. */ faviconFallback?: string | readonly FaviconLink[]; }
const { seo, faviconFallback } = Astro.props;
---
<SeoHead seo={seo} faviconFallback={faviconFallback} />
